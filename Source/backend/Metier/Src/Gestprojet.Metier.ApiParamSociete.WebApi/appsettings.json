{
  "ConnectionStrings": {
    "GestionProjetDB": "Server=.;Database=GestionProjetDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "URL": {
    "ApiParamSociete": "http://localhost:5050"
  },
  "Jwt": {
    "Key": "DefaultSecretKey12345678901234567890",
    "Issuer": "Gestprojet.Metier.ApiParamSociete.WebApi",
    "Audience": "Gestprojet.Metier.ApiParamSociete.Client"
  },
  "AI": {
    "Enabled": true,
    "Providers": {
      "Ollama": {
        "Enabled": true,
        "Url": "http://localhost:11434",
        "Model": "llama3.2"
      }
    },
    "Generation": {
