<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<Version>1.0.0.0</Version>
		<RootNamespace>Gestprojet.Core.ApiParamSociete.WebApi</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<IsPackable>true</IsPackable>
		<AssemblyVersion>$(AssemblyVersion)</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<VersionPrefix>
		</VersionPrefix>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="nul" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gestprojet.Core.ApiParamSociete.Application\Gestprojet.Core.ApiParamSociete.Application.csproj" />
    <ProjectReference Include="..\Gestprojet.Core.ApiParamSociete.Infrastructure\Gestprojet.Core.ApiParamSociete.Infrastructure.csproj" />
    <ProjectReference Include="..\Gestprojet.Core.ApiParamSociete.Domaine\Gestprojet.Core.ApiParamSociete.Domain.csproj" />
  </ItemGroup>

</Project>
