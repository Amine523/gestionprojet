import { TestBed } from '@angular/core/testing';
import { RouterTestingModule } from '@angular/router/testing';
import { HttpClientTestingModule } from '@angular/common/http/testing';
import { MatSnackBarModule } from '@angular/material/snack-bar';
import { MatDialogModule } from '@angular/material/dialog';
import { ApiService } from './services/api.service';

describe('NADHEMNI - Tests par Rôle', () => {
  let apiService: ApiService;

  beforeEach(() => {
    TestBed.configureTestingModule({
      imports: [
        RouterTestingModule,
        HttpClientTestingModule,
        MatSnackBarModule,
        MatDialogModule
      ],
      providers: [ApiService]
    });
    apiService = TestBed.inject(ApiService);
    localStorage.clear();
  });

  afterEach(() => {
    localStorage.clear();
  });

  // ==================== SUPER ADMIN ====================
  describe('Super Admin', () => {
    it('devrait avoir accès aux sociétés', () => {
      const mockSocietes = [
        { id: 'SOC_001', nom: 'TechCorp', domaine: 'Informatique', actif: true },
        { id: 'SOC_002', nom: 'FinancePlus', domaine: 'Finance', actif: true }
      ];
      apiService.setStorage({ societes: mockSocietes });
      const societes = apiService.getStorage().societes;
      expect(societes.length).toBe(2);
    });

    it('devrait gérer les abonnements', () => {
      const mockAbonnements = [
        { id: 'ABO_001', societeId: 'SOC_001', type: 'Professionnel', actif: true, prix: 299 }
      ];
      apiService.setStorage({ abonnements: mockAbonnements });
      const abonnements = apiService.getStorage().abonnements;
      expect(abonnements.length).toBe(1);
      expect(abonnements[0].actif).toBe(true);
    });

    it('devrait voir les abonnements actifs', () => {
      const mockAbonnements = [
        { societeId: 'SOC_001', type: 'Pro', actif: true },
        { societeId: 'SOC_002', type: 'Starter', actif: false }
      ];
      const actifs = mockAbonnements.filter(a => a.actif);
      expect(actifs.length).toBe(1);
    });

    it('devrait avoir accès au chat avec les sociétés', () => {
      const mockConversations = {
        'SOC_001': [
          { id: '1', text: 'Bonjour', from: 'admin1', fromName: 'Admin 1', time: '10:00' }
        ]
      };
      apiService.setStorage({ conversations: mockConversations });
      const conversations = apiService.getStorage().conversations;
      expect(conversations['SOC_001'].length).toBe(1);
    });
  });

  // ==================== ADMIN SOCIETE ====================
  describe('Admin Société', () => {
    it('devrait s\'authentifier', () => {
      const mockUser = {
        id: 'USER_001',
        nom: 'Admin Test',
        email: 'admin@test.com',
        typeUtilisateurId: 'admin_societe',
        societeId: 'SOC_001'
      };
      apiService.setCurrentUser(mockUser);
      const user = apiService.getCurrentUser();
      expect(user?.typeUtilisateurId).toBe('admin_societe');
    });

    it('devrait gérer les employés', () => {
      const mockEmployes = [
        { id: 'EMP_001', nom: 'Employé 1', email: 'emp1@test.com', societeId: 'SOC_001' },
        { id: 'EMP_002', nom: 'Employé 2', email: 'emp2@test.com', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ utilisateurs: mockEmployes });
      const employes = apiService.getStorage().utilisateurs.filter((u: any) => u.societeId === 'SOC_001');
      expect(employes.length).toBe(2);
    });

    it('devrait créer un abonnement', () => {
      const newAbonnement = {
        societeId: 'SOC_001',
        societeNom: 'TechCorp',
        type: 'Professionnel',
        nbUsers: 20,
        prix: 299,
        dateDebut: new Date().toISOString(),
        actif: true
      };
      apiService.setStorage({ abonnements: [newAbonnement] });
      const abonnements = apiService.getStorage().abonnements;
      expect(abonnements[0].type).toBe('Professionnel');
      expect(abonnements[0].actif).toBe(true);
    });

    it('devrait contacter le support (Super Admin)', () => {
      const mockMessage = {
        text: 'Demande d\'abonnement',
        from: 'USER_001',
        fromName: 'Admin Test',
        time: new Date().toLocaleTimeString('fr-FR')
      };
      const storage = apiService.getRawStorage();
      if (!storage.conversations) storage.conversations = {};
      if (!storage.conversations['SOC_001']) storage.conversations['SOC_001'] = [];
      storage.conversations['SOC_001'].push(mockMessage);
      localStorage.setItem('app_data', JSON.stringify(storage));
      
      const messages = apiService.getRawStorage().conversations['SOC_001'];
      expect(messages.length).toBe(1);
      expect(messages[0].text).toBe('Demande d\'abonnement');
    });
  });

  // ==================== RH ====================
  describe('RH', () => {
    it('devrait gérer les demandes de congés', () => {
      const mockConges = [
        { id: 1, employe: 'Employé 1', type: 'Annuel', dateDebut: '2026-04-10', dateFin: '2026-04-15', jours: 5, motif: 'Vacances', statut: 'en_attente', societeId: 'SOC_001' },
        { id: 2, employe: 'Employé 2', type: 'Maladie', dateDebut: '2026-04-05', dateFin: '2026-04-06', jours: 2, motif: 'Maladie', statut: 'valide', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ conges: mockConges });
      const conges = apiService.getStorage().conges.filter((c: any) => c.societeId === 'SOC_001');
      expect(conges.length).toBe(2);
    });

    it('devrait valider un congé', () => {
      const mockConges = [{ id: 1, statut: 'en_attente', societeId: 'SOC_001' }];
      apiService.setStorage({ conges: mockConges });
      const conge = apiService.getStorage().conges.find((c: any) => c.id === 1);
      conge.statut = 'valide';
      expect(conge.statut).toBe('valide');
    });

    it('devrait refuser un congé', () => {
      const mockConges = [{ id: 1, statut: 'en_attente', societeId: 'SOC_001' }];
      apiService.setStorage({ conges: mockConges });
      const conge = apiService.getStorage().conges.find((c: any) => c.id === 1);
      conge.statut = 'refuse';
      expect(conge.statut).toBe('refuse');
    });

    it('devrait calculer les statistiques de congés', () => {
      const mockConges = [
        { jours: 5, statut: 'valide' },
        { jours: 2, statut: 'valide' },
        { jours: 3, statut: 'en_attente' }
      ];
      const totalPris = mockConges.filter(c => c.statut === 'valide').reduce((acc, c) => acc + c.jours, 0);
      const enAttente = mockConges.filter(c => c.statut === 'en_attente').length;
      expect(totalPris).toBe(7);
      expect(enAttente).toBe(1);
    });

    it('devrait gérer le pointage', () => {
      const mockPointages = [
        { id: 1, employeId: 'EMP_001', date: '2026-04-07', heureEntree: '08:30', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ pointages: mockPointages });
      const pointages = apiService.getStorage().pointages;
      expect(pointages.length).toBe(1);
    });
  });

  // ==================== CHEF DE PROJET ====================
  describe('Chef de Projet', () => {
    it('devrait créer un projet', () => {
      const mockProjet = {
        id: 1,
        nom: 'Projet Test',
        societeId: 'SOC_001',
        statut: 'En cours',
        progression: 0,
        chefProjet: 'Chef Test'
      };
      apiService.setStorage({ projets: [mockProjet] });
      const projet = apiService.getStorage().projets[0];
      expect(projet.nom).toBe('Projet Test');
      expect(projet.statut).toBe('En cours');
    });

    it('devrait créer des tâches Kanban', () => {
      const mockTaches = [
        { id: 1, titre: 'Tâche 1', projetId: 1, statut: 'todo', priorite: 'High', assignee: null, societeId: 'SOC_001' },
        { id: 2, titre: 'Tâche 2', projetId: 1, statut: 'inprogress', priorite: 'Medium', assignee: 'EMP_001', societeId: 'SOC_001' },
        { id: 3, titre: 'Tâche 3', projetId: 1, statut: 'done', priorite: 'Low', assignee: 'EMP_001', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ taches: mockTaches });
      const taches = apiService.getStorage().taches;
      
      const todo = taches.filter(t => t.statut === 'todo').length;
      const inProgress = taches.filter(t => t.statut === 'inprogress').length;
      const done = taches.filter(t => t.statut === 'done').length;
      
      expect(todo).toBe(1);
      expect(inProgress).toBe(1);
      expect(done).toBe(1);
    });

    it('devrait déplacer une tâche entre colonnes', () => {
      const tache = { id: 1, titre: 'Tâche Test', statut: 'todo' };
      tache.statut = 'inprogress';
      expect(tache.statut).toBe('inprogress');
    });

    it('devrait assigner une tâche', () => {
      const tache = { id: 1, titre: 'Tâche Test', assignee: null };
      tache.assignee = 'EMP_001';
      expect(tache.assignee).toBe('EMP_001');
    });

    it('devrait gérer les bugs', () => {
      const mockBugs = [
        { id: 1, titre: 'Bug 1', projetId: 1, priorite: 'High', statut: 'Open', createur: 'Chef', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ bugs: mockBugs });
      const bugs = apiService.getStorage().bugs;
      expect(bugs.length).toBe(1);
      expect(bugs[0].statut).toBe('Open');
    });

    it('devrait suivre l\'avancement du projet', () => {
      const mockTaches = [
        { id: 1, statut: 'done' },
        { id: 2, statut: 'done' },
        { id: 3, statut: 'todo' },
        { id: 4, statut: 'todo' }
      ];
      const progression = (mockTaches.filter(t => t.statut === 'done').length / mockTaches.length) * 100;
      expect(progression).toBe(50);
    });
  });

  // ==================== DEVELOPPEUR ====================
  describe('Développeur', () => {
    it('devrait voir ses tâches assignées', () => {
      const mockTaches = [
        { id: 1, titre: 'Tâche 1', projetId: 1, assignee: 'DEV_001', societeId: 'SOC_001' },
        { id: 2, titre: 'Tâche 2', projetId: 1, assignee: 'DEV_001', societeId: 'SOC_001' },
        { id: 3, titre: 'Tâche 3', projetId: 1, assignee: 'DEV_002', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ taches: mockTaches });
      const mesTaches = apiService.getStorage().taches.filter((t: any) => t.assignee === 'DEV_001');
      expect(mesTaches.length).toBe(2);
    });

    it('devrait mettre à jour le statut d\'une tâche', () => {
      const tache = { id: 1, statut: 'todo' };
      tache.statut = 'inprogress';
      expect(tache.statut).toBe('inprogress');
    });

    it('devrait gérer les bugs assignés', () => {
      const mockBugs = [
        { id: 1, titre: 'Bug 1', projetId: 1, priorite: 'High', statut: 'Open', assignee: 'DEV_001' },
        { id: 2, titre: 'Bug 2', projetId: 1, priorite: 'Medium', statut: 'In Progress', assignee: 'DEV_001' }
      ];
      apiService.setStorage({ bugs: mockBugs });
      const mesBugs = apiService.getStorage().bugs.filter((b: any) => b.assignee === 'DEV_001');
      expect(mesBugs.length).toBe(2);
    });

    it('devrait suivre le temps de travail', () => {
      const mockTemps = [
        { id: 1, tacheId: 1, developpeurId: 'DEV_001', date: '2026-04-07', duree: 4 }
      ];
      apiService.setStorage({ temps: mockTemps });
      const temps = apiService.getStorage().temps;
      expect(temps.length).toBe(1);
      expect(temps[0].duree).toBe(4);
    });

    it('devrait faire du pointage', () => {
      const pointage = {
        id: 1,
        employeId: 'DEV_001',
        societeId: 'SOC_001',
        date: '2026-04-07',
        heureEntree: new Date().toLocaleTimeString('fr-FR')
      };
      apiService.setStorage({ pointages: [pointage] });
      const pointages = apiService.getStorage().pointages;
      expect(pointages.length).toBe(1);
    });
  });

  // ==================== TESTEUR QA ====================
  describe('Testeur QA', () => {
    it('devrait créer des plans de test', () => {
      const mockPlans = [
        { id: 1, nom: 'Plan Test 1', projetId: 1, description: 'Tests fonctionnels', societeId: 'SOC_001' }
      ];
      apiService.setStorage({ plansTest: mockPlans });
      const plans = apiService.getStorage().plansTest;
      expect(plans.length).toBe(1);
    });

    it('devrait exécuter des tests', () => {
      const mockCasTest = [
        { id: 1, planTestId: 1, nom: 'Test connexion', resultat: 'Passed', statut: 'Completed' }
      ];
      apiService.setStorage({ casTest: mockCasTest });
      const passed = apiService.getStorage().casTest.filter((c: any) => c.resultat === 'Passed').length;
      expect(passed).toBe(1);
    });

    it('devrait signaler des bugs', () => {
      const bug = {
        id: 1,
        titre: 'Bug trouvé',
        projetId: 1,
        priorite: 'High',
        statut: 'Open',
        createur: 'QA_001',
        stepsReproduction: '1. Ouvrir app\n2. Cliquer sur...\n3. Erreur',
        societeId: 'SOC_001'
      };
      apiService.setStorage({ bugs: [bug] });
      const bugs = apiService.getStorage().bugs;
      expect(bugs.length).toBe(1);
      expect(bugs[0].statut).toBe('Open');
    });
  });

  // ==================== CANDIDAT ====================
  describe('Candidat', () => {
    it('devrait voir les offres d\'emploi', () => {
      const mockOffres = [
        { id: 'OFF_001', titre: 'Développeur Frontend', societeId: 'SOC_001', statut: 'Ouverte' },
        { id: 'OFF_002', titre: 'Développeur Backend', societeId: 'SOC_001', statut: 'Ouverte' }
      ];
      apiService.setStorage({ offreEmplois: mockOffres });
      const offres = apiService.getStorage().offreEmplois.filter((o: any) => o.statut === 'Ouverte');
      expect(offres.length).toBe(2);
    });

    it('devrait postuler à une offre', () => {
      const candidature = {
        id: 'CAND_001',
        offreId: 'OFF_001',
        candidatNom: 'Candidat Test',
        candidatEmail: 'candidat@test.com',
        cv: 'cv.pdf',
        datePostulation: new Date().toISOString(),
        statut: 'En attente'
      };
      apiService.setStorage({ candidatures: [candidature] });
      const cand = apiService.getStorage().candidatures[0];
      expect(cand.statut).toBe('En attente');
    });

    it('devrait suivre ses candidatures', () => {
      const mockCandidatures = [
        { id: 'CAND_001', offreId: 'OFF_001', statut: 'En attente' },
        { id: 'CAND_002', offreId: 'OFF_002', statut: 'Acceptée' }
      ];
      apiService.setStorage({ candidatures: mockCandidatures });
      const enAttente = mockCandidatures.filter(c => c.statut === 'En attente').length;
      const acceptees = mockCandidatures.filter(c => c.statut === 'Acceptée').length;
      expect(enAttente).toBe(1);
      expect(acceptees).toBe(1);
    });
  });

  // ==================== RECRUTEMENT - POSTES ====================
  describe('Recrutement - Postes', () => {
    const postesDisponibles = [
      'Développeur Frontend',
      'Développeur Backend',
      'Développeur Full Stack',
      'Développeur Mobile',
      'DevOps Engineer',
      'Data Scientist',
      'Data Analyst',
      'Ingénieur QA',
      'Chef de Projet',
      'Product Manager',
      'UI/UX Designer',
      'Graphic Designer',
      'Consultant',
      'Analyste Fonctionnel',
      'Architecte Logiciel',
      'Tech Lead',
      'Scrum Master',
      'RH Manager',
      'Comptable',
      'Assistant Administratif',
      'Chef de Produit',
      'Marketing Manager',
      'Community Manager',
      'Content Manager',
      'Sales Manager',
      'Account Manager',
      'Customer Success Manager'
    ];

    it('devrait avoir 27 postes prédéfinis', () => {
      expect(postesDisponibles.length).toBe(27);
    });

    postesDisponibles.forEach((poste) => {
      it(`devrait permettre de créer une offre pour le poste: ${poste}`, () => {
        const offre = {
          id: 'OFF_' + Date.now(),
          titre: poste,
          poste: poste,
          description: `Nous cherchons un ${poste} pour notre équipe`,
          lieu: 'Tunis, Tunisia',
          salaire: '1500 - 3000 TND',
          type: 'CDI',
          statut: 'Ouverte',
          societeId: 'SOC_001',
          datePublication: new Date().toISOString()
        };
        
        apiService.setStorage({ offreEmplois: [offre] });
        const savedOffre = apiService.getStorage().offreEmplois[0];
        
        expect(savedOffre.titre).toBe(poste);
        expect(savedOffre.poste).toBe(poste);
        expect(savedOffre.statut).toBe('Ouverte');
      });
    });

    it('devrait permettre de créer un poste personnalisé', () => {
      const postePersonnalise = 'Expert Blockchain';
      const offre = {
        id: 'OFF_CUSTOM',
        titre: postePersonnalise,
        poste: postePersonnalise,
        description: 'Expert en blockchain',
        lieu: 'Tunis',
        type: 'CDI',
        statut: 'Ouverte',
        societeId: 'SOC_001'
      };
      
      apiService.setStorage({ offreEmplois: [offre] });
      const stored = apiService.getStorage().offreEmplois[0];
      
      expect(stored.titre).toBe('Expert Blockchain');
      expect(postesDisponibles).not.toContain('Expert Blockchain');
    });

    it('devrait filtrer les candidats par poste', () => {
      const mockOffres = [
        { id: 'OFF_001', titre: 'Développeur Frontend', poste: 'Développeur Frontend' },
        { id: 'OFF_002', titre: 'Data Scientist', poste: 'Data Scientist' }
      ];
      const mockCandidats = [
        { id: 'CAND_001', poste: 'Développeur Frontend', nom: 'Candidat 1' },
        { id: 'CAND_002', poste: 'Développeur Frontend', nom: 'Candidat 2' },
        { id: 'CAND_003', poste: 'Data Scientist', nom: 'Candidat 3' }
      ];
      
      apiService.setStorage({ offreEmplois: mockOffres, utilisateurs: mockCandidats });
      
      const candidatsFrontend = mockCandidats.filter(c => c.poste === 'Développeur Frontend');
      const candidatsData = mockCandidats.filter(c => c.poste === 'Data Scientist');
      
      expect(candidatsFrontend.length).toBe(2);
      expect(candidatsData.length).toBe(1);
    });

    it('devrait valider les candidats par poste', () => {
      const mockCandidats = [
        { id: 'CAND_001', poste: 'Développeur Backend', statut: 'En attente' },
        { id: 'CAND_002', poste: 'Développeur Backend', statut: 'En attente' }
      ];
      
      const storage = apiService.getRawStorage();
      storage.candidatures = mockCandidats;
      localStorage.setItem('app_data', JSON.stringify(storage));
      
      storage.candidatures[0].statut = 'Acceptée';
      localStorage.setItem('app_data', JSON.stringify(storage));
      
      const accepte = storage.candidatures.filter(c => c.statut === 'Acceptée').length;
      const enAttente = storage.candidatures.filter(c => c.statut === 'En attente').length;
      
      expect(accepte).toBe(1);
      expect(enAttente).toBe(1);
    });
  });

  // ==================== TESTS D'INTEGRATION ====================
  describe('Tests d\'intégration', () => {
    it('devrait valider la création et la visibilité d\'un abonnement', () => {
      const abonnement = {
        societeId: 'SOC_001',
        societeNom: 'TechCorp',
        type: 'Professionnel',
        adminId: 'USER_001',
        adminNom: 'Admin Test',
        actif: true,
        prix: 299
      };
      apiService.setStorage({ abonnements: [abonnement] });
      
      // 2. Super Admin voit l'abonnement
      const storage = apiService.getStorage();
      const aboActif = storage.abonnements.find((a: any) => a.actif);
      
      expect(aboActif.type).toBe('Professionnel');
      expect(aboActif.adminNom).toBe('Admin Test');
    });

    it('devrait permettre le flux de validation de congé', () => {
      // 1. Employé fait une demande
      const conge = { id: 1, employe: 'Emp 1', type: 'Annuel', statut: 'en_attente', societeId: 'SOC_001' };
      apiService.setStorage({ conges: [conge] });
      
      // 2. RH valide
      let storage = apiService.getRawStorage();
      const congeToValidate = storage.conges.find((c: any) => c.id === 1);
      congeToValidate.statut = 'valide';
      localStorage.setItem('app_data', JSON.stringify(storage));
      
      // 3. Vérification
      storage = apiService.getRawStorage();
      expect(storage.conges[0].statut).toBe('valide');
    });

    it('devrait permettre le flux de chat Admin vers Super Admin', () => {
      // 1. Admin envoie un message
      const message = {
        id: 1,
        text: 'Bonjour Super Admin',
        from: 'ADMIN_001',
        fromName: 'Admin',
        time: '10:00',
        date: new Date().toISOString()
      };
      const storage = apiService.getRawStorage();
      if (!storage.conversations) storage.conversations = {};
      storage.conversations['SOC_001'] = [message];
      localStorage.setItem('app_data', JSON.stringify(storage));
      
      // 2. Super Admin lit le message
      const conv = apiService.getRawStorage().conversations['SOC_001'];
      expect(conv[0].text).toBe('Bonjour Super Admin');
    });
  });
});
