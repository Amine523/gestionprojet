        private static System.Collections.Generic.List<string> GetErrors(System.Collections.Generic.Dictionary<string, object> problemDetails)
        {
            if (problemDetails == null || !problemDetails.Any()) return null;

            string errorList = null;

            foreach (string key in problemDetails.Keys)
            {
                if (string.Compare(key, "errors", true) == 0)
                {
                    object value = problemDetails[key];
                    if (value == null) continue;

                    try
                    {
                        var completeErrorList = new System.Collections.Generic.List<string>();
                        var errorDetailList = Newtonsoft.Json.JsonConvert.DeserializeObject<System.Collections.Generic.IDictionary<string, string[]>>(value.ToString());
                        foreach (var errorDetail in errorDetailList)
                        {
                            completeErrorList.Add(Newtonsoft.Json.JsonConvert.SerializeObject(errorDetail));
                        }
                        return completeErrorList;
                    }
                    catch
                    {
                        errorList = value.ToString();
                    }
                    break;
                }

                if (string.Compare(key, "extensions", true) == 0)
                {
                    System.Collections.Generic.Dictionary<string, object> extensions = Newtonsoft.Json.JsonConvert.DeserializeObject<System.Collections.Generic.Dictionary<string, object>>(problemDetails[key].ToString());
                    return GetErrors(extensions);
                }
            }

            if (string.IsNullOrEmpty(errorList)) return null;

            return Newtonsoft.Json.JsonConvert.DeserializeObject<System.Collections.Generic.List<string>>(errorList);
        }

        private static string GetDetail(System.Collections.Generic.Dictionary<string, object> problemDetails)
        {
            foreach(string key in problemDetails.Keys)
            {
                if (string.Compare(key, "detail", true) == 0 && problemDetails[key] != null) return problemDetails[key].ToString();
            }
            return string.Empty;
        }

        private static string GetLocation(System.Collections.Generic.Dictionary<string, System.Collections.Generic.IEnumerable<string>> headers)
        {
            if (headers == null || !headers.Any() || !headers.Any(p => p.Key.ToLower() == "location")) return null;

            System.Collections.Generic.IEnumerable<string> values = headers.FirstOrDefault(p => p.Key.ToLower() == "location").Value;
            if (values == null || !values.Any()) return null;

            string value = values.FirstOrDefault();

            if (value.StartsWith("http")) return value.Substring(value.LastIndexOf('/')+1);

            return value;
        }

        private static async System.Threading.Tasks.Task<string> ReadResponseAsText(System.Net.Http.HttpResponseMessage response)
        {
            if (response == null || response.Content == null) return string.Empty;

            return await response.Content.ReadAsStringAsync().ConfigureAwait(false);
        }

        private static bool TryParseProblemDetails(string responseText, out System.Collections.Generic.Dictionary<string, object> problemDetails)
        {
            problemDetails = null;

            if (string.IsNullOrEmpty(responseText)) return false;

            try
            {
                System.Collections.Generic.Dictionary<string, object> value = Newtonsoft.Json.JsonConvert.DeserializeObject<System.Collections.Generic.Dictionary<string, object>>(responseText);
                if (value == null) return false;

                problemDetails = value;
                return true;
            }
            catch
            {
                return false;
            }
        }

         private static async  System.Threading.Tasks.Task<string> ReadBodyAsync(System.Net.Http.HttpContent content)
        {
            if (content == null) return null;

            return await content.ReadAsStringAsync();
        }
