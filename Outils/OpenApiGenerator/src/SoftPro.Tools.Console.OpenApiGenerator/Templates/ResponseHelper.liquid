       /// <summary>
        /// Traite la réponse lorsque le type de retour est de type application/json
        /// </summary>
        /// <typeparam name="T"></typeparam>
        /// <param name="response"></param>
        /// <param name="cancellationToken"></param>
        /// <returns></returns>
        public static async System.Threading.Tasks.Task<T> ProcessResponseAsync<T>( System.Net.Http.HttpResponseMessage response, System.Collections.Generic.Dictionary<string, System.Collections.Generic.IEnumerable<string>> headers, System.Threading.CancellationToken cancellationToken)
        {
             string responseText = await ReadResponseAsText(response);

            // 404 : Pas d'exception levée, le retour sera null
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return default;

            // Réponse OK : Dans la plage 200 - 299
            if (response.IsSuccessStatusCode)
            {
                try
                {
                    return Newtonsoft.Json.JsonConvert.DeserializeObject<T>(responseText);
                }
                catch
                {
                    // throw new SoftProRestClientException 
                    //throw new SoftPro.Framework.Core.Exceptions.SoftProRestClientException(System.Net.HttpStatusCode.InternalServerError, $"Impossible de caster en {typeof(T)} : {responseText} " , null, null);
                    throw new Exception("Erreur de génération.");
                }
             }
         
             throw await CreateProblemDetailsExceptionAsync(response.StatusCode, response, responseText);
        }

        public static async System.Threading.Tasks.Task<FileResponse> ProcessFileResponseAsync<T>(System.Net.Http.HttpResponseMessage response, System.Collections.Generic.Dictionary<string, System.Collections.Generic.IEnumerable<string>> headers_, System.Threading.CancellationToken cancellationToken)
        {
            if (response.IsSuccessStatusCode)
            {
                byte[] fileContent = await response.Content.ReadAsByteArrayAsync().ConfigureAwait(false);
                string fileName = string.Empty;

                System.Collections.Generic.IEnumerable<string> contentDispositionHeaders = null;

                foreach (System.Collections.Generic.KeyValuePair<string, System.Collections.Generic.IEnumerable<string>> header in headers_)
                {
                    string headerKey = header.Key.ToLower();

                    if (string.Compare(headerKey, "content-disposition", true) == 0)
                    {
                        contentDispositionHeaders = header.Value;
                        break;
                    }
                }

                if(contentDispositionHeaders != null)
                {
                    string headerValue = contentDispositionHeaders.FirstOrDefault();
                    if (!string.IsNullOrEmpty(headerValue))
                    {
                        string[] values = headerValue.Split(";");
                        if (values != null && values.Length > 0)
                        {
                            foreach (string value in values)
                            {
                                if (string.IsNullOrEmpty(value)) continue;

                                string[] keyValues = value.Split("=");
                                if (keyValues == null || keyValues.Length != 2) continue;

                                if (string.Compare(keyValues[0].Trim(), "filename", true) == 0)
                                {
                                    fileName = keyValues[1];
                                    break;
                                }
                            }
                        }
                    }
                }

                return new FileResponse()
                {
                    Datas = fileContent,
                    FileName = fileName
                };
            }

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                return default;
            }
            
            string responseText = await ReadResponseAsText(response);
            throw await CreateProblemDetailsExceptionAsync(response.StatusCode, response, responseText);
        }

        public static async System.Threading.Tasks.Task<SoftProRestResponse> CreateSoftProRestResponse(System.Net.Http.HttpResponseMessage response, System.Collections.Generic.Dictionary<string, System.Collections.Generic.IEnumerable<string>> headers, System.Threading.CancellationToken cancellationToken)
        {
            string responseText = await ReadResponseAsText(response);

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                return new SoftProRestResponse
                {
                    Success = response.IsSuccessStatusCode,
                    StatutCode = response.StatusCode,
                    ResponseText = responseText,
                    Headers = new SoftProRestHeaders()
                    {
                        Location = GetLocation(headers)
                    }
                };
            }

            throw await CreateProblemDetailsExceptionAsync(response.StatusCode, response, responseText);
        }

